# Copy to .env.local. Keep credentials out of Git.
# Local mode stores data in .ontime/data; no Tiger Data account is required.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=.ontime/data
API_PORT=3001
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# To use Tiger Data: set DATABASE_MODE=tiger and supply the dashboard URL,
# including its required TLS parameters. Do not disable certificate verification.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# The frontend Worker uses API_BASE_URL from .dev.vars if API_PORT is changed.
# API_BASE_URL=http://127.0.0.1:3001
